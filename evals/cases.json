{
  "_about": "Labeled sentences for measuring the AI parser. Setup is fixed so results are repeatable. 'expect' is a list of acceptable outcomes; a case passes if the result matches any one. Only the fields listed in an outcome are checked. Kinds: task, add_pet, remove_pet, question (the AI asked the user something), error (the request was rejected). 'split' is dev (fine to tune against) or test (hold-out: run only for the final score).",
  "setup": {
    "today": "2026-11-14",
    "pets": [
      {"name": "Mochi", "species": "dog", "tasks": 1},
      {"name": "Max", "species": "cat", "tasks": 0}
    ]
  },
  "cases": [
    {"id": "t01", "split": "dev", "text": "starting tomorrow, walk Mochi every day at 8am for 30 minutes, high priority",
     "expect": [{"kind": "task", "pet": "Mochi", "due": "2026-11-15T08:00", "duration": 30, "priority": "high", "frequency": "daily"}]},
    {"id": "t02", "split": "dev", "text": "feed Max tomorrow at 7:30am for 10 minutes",
     "expect": [{"kind": "task", "pet": "Max", "due": "2026-11-15T07:30", "duration": 10}]},
    {"id": "t03", "split": "dev", "text": "Mochi has a vet appointment on Friday at 2pm for 60 minutes, high priority",
     "expect": [{"kind": "task", "pet": "Mochi", "due": "2026-11-20T14:00", "duration": 60, "priority": "high"}]},
    {"id": "t04", "split": "dev", "text": "give Max his medicine every week on Monday at 6pm for 5 minutes",
     "expect": [{"kind": "task", "pet": "Max", "due": "2026-11-16T18:00", "duration": 5, "frequency": "weekly"}]},
    {"id": "t05", "split": "dev", "text": "groom Mochi on Wednesday at 10am for 45 minutes, low priority",
     "expect": [{"kind": "task", "pet": "Mochi", "due": "2026-11-18T10:00", "duration": 45, "priority": "low"}]},
    {"id": "t06", "split": "dev", "text": "play with Max tonight at 7pm for 20 minutes",
     "expect": [{"kind": "task", "pet": "Max", "due": "2026-11-14T19:00", "duration": 20}]},
    {"id": "t07", "split": "dev", "text": "uh walk mochi tomorrow at eight in the morning for like thirty minutes",
     "expect": [{"kind": "task", "pet": "Mochi", "due": "2026-11-15T08:00", "duration": 30}]},
    {"id": "t08", "split": "dev", "text": "Max needs his nails trimmed Thursday at 4pm for 15 minutes",
     "expect": [{"kind": "task", "pet": "Max", "due": "2026-11-19T16:00", "duration": 15}]},

    {"id": "p01", "split": "dev", "text": "add a cat named Luna",
     "expect": [{"kind": "add_pet", "name": "Luna", "species": "cat"}]},
    {"id": "p02", "split": "dev", "text": "I got a new dog, his name is Biscuit",
     "expect": [{"kind": "add_pet", "name": "Biscuit", "species": "dog"}]},
    {"id": "p03", "split": "dev", "text": "add a rabbit named Clover",
     "expect": [{"kind": "add_pet", "name": "Clover", "species": "other"}]},
    {"id": "p04", "split": "dev", "text": "add a pet named Pixel",
     "expect": [{"kind": "question"}]},

    {"id": "r01", "split": "dev", "text": "remove Max",
     "expect": [{"kind": "remove_pet", "pet": "Max"}]},
    {"id": "r02", "split": "dev", "text": "delete Mochi from my pets",
     "expect": [{"kind": "remove_pet", "pet": "Mochi"}]},
    {"id": "r03", "split": "dev", "text": "remove my pet",
     "expect": [{"kind": "question"}]},

    {"id": "q01", "split": "dev", "text": "vet appointment tomorrow at 9",
     "expect": [{"kind": "question"}]},
    {"id": "q02", "split": "dev", "text": "walk Mochi for 30 minutes",
     "expect": [{"kind": "question"}]},
    {"id": "q03", "split": "dev", "text": "feed tomorrow at 7am for 10 minutes",
     "expect": [{"kind": "question"}]},

    {"id": "e01", "split": "dev", "text": "add a dog named Mochi",
     "expect": [{"kind": "error"}]},
    {"id": "e02", "split": "dev", "text": "feed Rex tomorrow at 7am for 10 minutes",
     "expect": [{"kind": "question"}, {"kind": "error"}]},
    {"id": "x01", "split": "dev", "text": "feed Mocha tomorrow at 7am for 10 minutes",
     "expect": [{"kind": "task", "pet": "Mochi", "due": "2026-11-15T07:00", "duration": 10}, {"kind": "question"}]},

    {"id": "T01", "split": "test", "text": "walk Max every day at 6pm for 20 minutes starting tomorrow",
     "expect": [{"kind": "task", "pet": "Max", "due": "2026-11-15T18:00", "duration": 20, "frequency": "daily"}]},
    {"id": "T02", "split": "test", "text": "Mochi bath on Tuesday at 5pm for 40 minutes",
     "expect": [{"kind": "task", "pet": "Mochi", "due": "2026-11-17T17:00", "duration": 40}]},
    {"id": "T03", "split": "test", "text": "put a medication reminder for Mochi tomorrow at 9am, 5 minutes, high priority",
     "expect": [{"kind": "task", "pet": "Mochi", "due": "2026-11-15T09:00", "duration": 5, "priority": "high"}]},
    {"id": "T04", "split": "test", "text": "Mochi needs a haircut on Friday at 11am for an hour",
     "expect": [{"kind": "task", "pet": "Mochi", "due": "2026-11-20T11:00", "duration": 60}]},
    {"id": "T05", "split": "test", "text": "add a 3 year old golden retriever named Sunny",
     "expect": [{"kind": "add_pet", "name": "Sunny", "species": "dog"}]},
    {"id": "T06", "split": "test", "text": "register my parrot Kiwi",
     "expect": [{"kind": "add_pet", "name": "Kiwi", "species": "other"}]},
    {"id": "T07", "split": "test", "text": "I gave Max away, remove him from the app",
     "expect": [{"kind": "remove_pet", "pet": "Max"}]},
    {"id": "T08", "split": "test", "text": "walk at 8am",
     "expect": [{"kind": "question"}]},
    {"id": "T09", "split": "test", "text": "walk Mochi tomorrow for half an hour",
     "expect": [{"kind": "question"}]},
    {"id": "T10", "split": "test", "text": "add a cat named max",
     "expect": [{"kind": "error"}]},
    {"id": "T11", "split": "test", "text": "remove Luna",
     "expect": [{"kind": "error"}, {"kind": "question"}]},
    {"id": "T12", "split": "test", "text": "walk Maxx tomorrow at 6pm for 20 minutes",
     "expect": [{"kind": "task", "pet": "Max", "due": "2026-11-15T18:00", "duration": 20}, {"kind": "question"}]}
  ]
}
